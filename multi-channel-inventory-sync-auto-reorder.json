        "jsCode": "const payload = $json.body || $json;\nconst data = (payload.notification && payload.notification.data) || payload.data || payload;\n\nconst lineItems = (data.lineItems || []).map(li => ({\n  sku: li.sku,\n  quantity: li.quantity,\n  title: li.title\n}));\n\nconst cancelState = (data.cancelStatus && data.cancelStatus.cancelState) || 'NONE_REQUESTED';\nconst eventType = cancelState === 'CANCELED' ? 'order_cancelled' : 'order_created';\nconst orderId = data.orderId;\n\nreturn [{\n  json: {\n    source_channel: 'eBay',\n    order_id: `ebay-${orderId}`,\n    event_type: eventType,\n    order_number: orderId,\n    line_items: lineItems,\n    raw_order_id: orderId\n  }\n}];"
