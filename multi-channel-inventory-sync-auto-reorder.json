        "jsCode": "const d = $json;\n// Cancelled orders restock; created orders decrement.\nconst delta = d.event_type === 'order_cancelled' ? d.quantity : -d.quantity;\nconst newStock = d.currentStock + delta;\nconst needsReorderAlert = newStock <= d.reorderThreshold && !d.reorderAlertActive;\n\nreturn [{ json: { ...d, newStock, needsReorderAlert } }];"
